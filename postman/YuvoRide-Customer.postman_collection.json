{
  "info": {
    "_postman_id": "c9e5a0f3-6d41-4e93-b07c-customer-api-2026",
    "name": "YuvoRide Customer API",
    "description": "Customer /v1 APIs. After Verify OTP or Google Login, tokens are saved automatically.\n\nCreate ride starts as REQUESTED (offered to nearby online KYC-verified drivers — not auto-assigned).\nCancel sets RIDE_CANCELLED.\nFare/distance/duration/status are server-owned; do not send them from the client.\n\nPickup/destination accept latitude+longitude+address or lat+lng+label.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "phone", "value": "+919999999999" },
    { "key": "otp", "value": "123456" },
    { "key": "vehicleTypeId", "value": "2" },
    { "key": "rideId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/otp/send",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "otp", "send"]
            },
            "description": "OTP is never returned. Mock SMS logs last 4 digits of the phone."
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const data = json.data || json;",
                  "  const access = data.accessToken || data.token;",
                  "  if (access) pm.collectionVariables.set('accessToken', access);",
                  "  if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "otp", "verify"]
            }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/otp/resend",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "otp", "resend"]
            }
          }
        },
        {
          "name": "Google Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const data = json.data || json;",
                  "  const access = data.accessToken || data.token;",
                  "  if (access) pm.collectionVariables.set('accessToken', access);",
                  "  if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"GOOGLE_ID_TOKEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "google"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const data = json.data || json;",
                  "  const access = data.accessToken || data.token;",
                  "  if (access) pm.collectionVariables.set('accessToken', access);",
                  "  if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "List Vehicle Types",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const list = (json.data && json.data.content) || json.data || [];",
                  "  const mini = Array.isArray(list) ? list.find(v => v.name === 'Mini') : null;",
                  "  const first = Array.isArray(list) && list[0];",
                  "  const id = (mini && mini.id) || (first && first.id);",
                  "  if (id) pm.collectionVariables.set('vehicleTypeId', String(id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "vehicles"]
            },
            "description": "Public. Saves vehicleTypeId (prefers Mini)."
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "me"]
            }
          }
        },
        {
          "name": "Update Current User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User Name\",\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "me"]
            },
            "description": "Cannot change id, role, status, or createdAt."
          }
        },
        {
          "name": "Upload Profile Photo",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "JPEG, PNG, or WebP, max 5MB"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/users/me/photo",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "me", "photo"]
            }
          }
        }
      ]
    },
    {
      "name": "Rides",
      "item": [
        {
          "name": "Estimate Ride",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"latitude\": 25.5941,\n    \"longitude\": 85.1376,\n    \"address\": \"Patna\"\n  },\n  \"destination\": {\n    \"latitude\": 26.1197,\n    \"longitude\": 85.3910,\n    \"address\": \"Muzaffarpur\"\n  },\n  \"vehicleTypeId\": {{vehicleTypeId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/rides/estimate",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rides", "estimate"]
            },
            "description": "Needs GOOGLE_MAPS_API_KEY. Fare is calculated on the server."
          }
        },
        {
          "name": "Create Ride",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('rideId', String(json.data.id));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"latitude\": 25.5941,\n    \"longitude\": 85.1376,\n    \"address\": \"Patna\"\n  },\n  \"destination\": {\n    \"latitude\": 26.1197,\n    \"longitude\": 85.3910,\n    \"address\": \"Muzaffarpur\"\n  },\n  \"vehicleTypeId\": {{vehicleTypeId}},\n  \"scheduledAt\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/rides",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rides"]
            },
            "description": "Status starts REQUESTED. Matching offers to drivers; it does not auto-assign."
          }
        },
        {
          "name": "Get Ride",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/rides/{{rideId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rides", "{{rideId}}"]
            }
          }
        },
        {
          "name": "Ride History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/rides/history?page=0&size=20&sort=createdAt,desc",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rides", "history"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "status", "value": "COMPLETED", "disabled": true, "description": "Optional RideStatus" },
                { "key": "sort", "value": "createdAt,desc" }
              ]
            }
          }
        },
        {
          "name": "Cancel Ride",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed my plan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/rides/{{rideId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rides", "{{rideId}}", "cancel"]
            },
            "description": "Sets RIDE_CANCELLED. Not allowed after RIDE_STARTED / COMPLETED."
          }
        }
      ]
    }
  ]
}
