{
  "info": {
    "name": "YuvoRide Driver API",
    "description": "Driver app contract. Register → login OTP → verify (saves token) → go online → location → accept rides.\nDriver APIs require ROLE_DRIVER. KYC VERIFIED + ACTIVE is required before going online.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "email", "value": "driver@example.com" },
    { "key": "phone", "value": "+918888888888" },
    { "key": "otp", "value": "123456" },
    { "key": "rideId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"dob\": \"1995-01-15\",\n  \"phone\": \"{{phone}}\",\n  \"email\": \"{{email}}\",\n  \"address\": \"Patna, Bihar\",\n  \"photoUri\": \"content://photo\",\n  \"identityType\": \"AADHAAR\",\n  \"identityNumber\": \"XXXX-XXXX-1234\",\n  \"identityUri\": \"content://id\",\n  \"vehicleType\": \"Sedan\",\n  \"vehicleNumber\": \"BR01AB1234\",\n  \"rcNumber\": \"RC123\",\n  \"rcUri\": \"content://rc\",\n  \"licenseNumber\": \"DL123456\",\n  \"licenseUri\": \"content://license\"\n}"
            },
            "url": "{{baseUrl}}/auth/driver/register",
            "description": "Creates DRIVER user + KYC PENDING profile. Local URIs are stored as unverified refs, not trusted documents."
          }
        },
        {
          "name": "Login (send OTP)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"role\": \"driver\"\n}"
            },
            "url": "{{baseUrl}}/auth/driver/login"
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) pm.collectionVariables.set('accessToken', json.token);",
                  "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\",\n  \"role\": \"driver\"\n}"
            },
            "url": "{{baseUrl}}/auth/driver/verify-otp",
            "description": "Returns { token, refreshToken, user } without the v1 ApiResponse wrapper."
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"role\": \"driver\"\n}"
            },
            "url": "{{baseUrl}}/auth/driver/forgot-password"
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const access = json.accessToken || json.token;",
                  "  if (access) pm.collectionVariables.set('accessToken', access);",
                  "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "GET me",
          "request": { "method": "GET", "url": "{{baseUrl}}/driver/me" }
        },
        {
          "name": "PATCH me",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"phone\": \"{{phone}}\",\n  \"address\": \"Patna\"\n}"
            },
            "url": "{{baseUrl}}/driver/me"
          }
        },
        {
          "name": "Go online",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"online\": true\n}" },
            "url": "{{baseUrl}}/driver/availability",
            "description": "Requires ACTIVE + KYC VERIFIED (admin must approve KYC first)."
          }
        },
        {
          "name": "Go offline",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"online\": false\n}" },
            "url": "{{baseUrl}}/driver/availability"
          }
        },
        {
          "name": "Update location",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 25.5941,\n  \"lng\": 85.1376,\n  \"accuracy\": 10,\n  \"heading\": 90,\n  \"speed\": 10\n}"
            },
            "url": "{{baseUrl}}/driver/location"
          }
        }
      ]
    },
    {
      "name": "Rides",
      "item": [
        {
          "name": "Open requests",
          "request": { "method": "GET", "url": "{{baseUrl}}/driver/rides/requests" }
        },
        {
          "name": "Active ride",
          "request": { "method": "GET", "url": "{{baseUrl}}/driver/rides/active" }
        },
        {
          "name": "History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/driver/rides/history?page=0&size=20"
          }
        },
        {
          "name": "Get ride",
          "request": { "method": "GET", "url": "{{baseUrl}}/driver/rides/{{rideId}}" }
        },
        {
          "name": "Accept",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const id = json.id || (json.data && json.data.id);",
                  "  if (id) pm.collectionVariables.set('rideId', String(id));",
                  "}"
                ]
              }
            }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/driver/rides/{{rideId}}/accept" }
        },
        {
          "name": "Reject",
          "request": { "method": "POST", "url": "{{baseUrl}}/driver/rides/{{rideId}}/reject" }
        },
        {
          "name": "Status GOING_TO_PICKUP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"GOING_TO_PICKUP\"\n}" },
            "url": "{{baseUrl}}/driver/rides/{{rideId}}/status"
          }
        },
        {
          "name": "Status ARRIVED",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ARRIVED\"\n}" },
            "url": "{{baseUrl}}/driver/rides/{{rideId}}/status"
          }
        },
        {
          "name": "Start",
          "request": { "method": "POST", "url": "{{baseUrl}}/driver/rides/{{rideId}}/start" }
        },
        {
          "name": "Status GOING_TO_DESTINATION",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"GOING_TO_DESTINATION\"\n}" },
            "url": "{{baseUrl}}/driver/rides/{{rideId}}/status"
          }
        },
        {
          "name": "Complete",
          "request": { "method": "POST", "url": "{{baseUrl}}/driver/rides/{{rideId}}/complete" }
        },
        {
          "name": "Cancel",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Customer not reachable\"\n}" },
            "url": "{{baseUrl}}/driver/rides/{{rideId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Earnings",
      "item": [
        {
          "name": "GET earnings",
          "request": { "method": "GET", "url": "{{baseUrl}}/driver/earnings" }
        }
      ]
    }
  ]
}
